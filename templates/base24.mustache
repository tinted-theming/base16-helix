"special" = "base0D"
"string"  = "base0B"
"type" = "base0A"
"variable" = "base08"
"variable.other.member" = "base0B"
"warning" = "base09"

"markup.bold" = { fg = "base13", modifiers = ["bold"] }
"markup.heading" = "base16"
"markup.italic" = { fg = "base17", modifiers = ["italic"] }
"markup.link.text" = "base12"
